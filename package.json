{
  "private": true,
  "packageManager": "pnpm@10.20.0",
  "pnpm": {
    "overrides": {
      "@nuxt/devtools": "3.1.1",
      "vue": "^3.5.29",
      "esm-env": "npm:esm-env-runtime@^0.1.1",
      "commander": "^13.1.0",
      "citty": "^0.2.1",
      "@intlify/unplugin-vue-i18n": "^11.1.1"
    }
  },
  "devDependencies": {
    "prettier": "^3.5.3",
    "prettier-plugin-tailwindcss": "^0.6.14"
  },
  "scripts": {
    "dev:megabuild": "pnpm --filter @events/megabuild dev",
    "dev:keramika": "pnpm --filter @events/keramika dev",
    "dev:renex": "pnpm --filter @events/renex dev",
    "dev:flei": "pnpm --filter @events/flei dev",
    "dev:cafeexpo": "pnpm --filter @events/cafeexpo dev",
    "dev:icf": "pnpm --filter @events/icf dev",
    "dev:cokelatexpo": "pnpm --filter @events/cokelatexpo dev",
    "dev:morefood": "pnpm --filter @events/morefood dev",
    "dev:outingexpo": "pnpm --filter @events/outingexpo dev",
    "dev:icc": "pnpm --filter @events/icc dev",
    "dev:inacon": "pnpm --filter @events/inacon dev",
    "build:megabuild": "pnpm --filter @events/megabuild build",
    "build:keramika": "pnpm --filter @events/keramika build",
    "build:renex": "pnpm --filter @events/renex build",
    "build:flei": "pnpm --filter @events/flei build",
    "build:cafeexpo": "pnpm --filter @events/cafeexpo build",
    "build:icf": "pnpm --filter @events/icf build",
    "build:cokelatexpo": "pnpm --filter @events/cokelatexpo build",
    "build:morefood": "pnpm --filter @events/morefood build",
    "build:outingexpo": "pnpm --filter @events/outingexpo build",
    "build:icc": "pnpm --filter @events/icc build",
    "build:inacon": "pnpm --filter @events/inacon build",
    "build:all": "pnpm -r --filter './apps/*' build"
  }
}
